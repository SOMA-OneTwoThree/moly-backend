APP_NAME=moly-backend
ENVIRONMENT=local
# 개발 Swagger에서 /dev 진단 route를 등록하는 이중 게이트. production/staging은 true여도 등록 안 됨.
ENABLE_DEV_ROUTES=false
# 비용·강제 생성 route를 실행할 수 있는 인증 사용자 UUID comma-separated allowlist.
DEV_OPERATOR_USER_IDS=

# --- Supabase (Auth + Postgres + pgvector) ---
SUPABASE_URL=
# 신형 API 키(대시보드 → API Keys → Publishable and secret API keys).
# legacy anon/service_role(eyJ...)은 2026-08 유출로 disable — 더 이상 쓰지 않는다.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# JWT 검증(JWKS 로컬 검증) — 미설정 시 remote getUser 폴백(auth 설계 단계에서 확정)
SUPABASE_JWKS_URL=
# API 서버 전용 DB 쓰기(서비스 롤). 클라 직접 쓰기 없음(ERD §8)
SUPABASE_DB_CONNECTION_STRING=

# --- Anthropic Claude (대화·개인일기=Sonnet / self-check·기억통합=Haiku) ---
# 대화 Haiku A/B는 ANTHROPIC_MODEL_CHAT만 claude-haiku-4-5로 바꾸면 된다(일기는 안 딸려간다).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHAT=claude-sonnet-5
ANTHROPIC_MODEL_DIARY=claude-sonnet-5
ANTHROPIC_MODEL_UTILITY=claude-haiku-4-5-20251001

# --- FCM 푸시(Firebase Cloud Messaging) — 워커 아침/저녁 알림 ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=          # service account JSON 경로(예: secrets/fcm-service-account.json)

# --- App Store(StoreKit) — JWS x5c 서명검증(구독/IAP/ASSN 웹훅) ---
# 서명검증만 하므로 .p8/Key ID/Issuer ID 불필요(App Store Server API 조회 안 함). Bundle ID면 충분.
APP_STORE_BUNDLE_ID=              # 앱 번들 ID(예: com.geniusjun.moly) — 미설정 시 로컬 미검증/비로컬 거부
APP_STORE_ENVIRONMENT=Sandbox     # Sandbox | Production
APP_STORE_APP_APPLE_ID=          # 앱 숫자 ID(App Store Connect 앱 정보) — Production 알림 검증 시 필요

# --- Meta 설치 귀속 --- Google Play 설치 리퍼러 utm_content 복호화 키(64자 hex).
# Events Manager에서 발급받은 값을 배포 환경에만 주입한다. 비면 복호화 엔드포인트가 503.
META_INSTALL_REFERRER_DECRYPTION_KEY=

# --- Slack 운영 알림 ---
# Incoming Webhook은 채널별로 발급. 피드백 전용 URL 미설정 시 ALERT → 공용 URL 순으로 폴백.
SLACK_WEBHOOK_URL=
SLACK_ALERT_WEBHOOK_URL=
SLACK_STATUS_WEBHOOK_URL=
SLACK_FEEDBACK_WEBHOOK_URL=

# --- 정규화 장기기억(OpenAI embedding + PostgreSQL pgvector) ---
OPENAI_API_KEY=
EMBEDDER_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536

# --- 대화 모델 A/B 테스트(dev 전용, /dev/chat-eval). Gemini만 별도 키 필요(OpenAI는 위 키 재사용) ---
GEMINI_API_KEY=

# --- 대화 회상 런타임 ---
AGENT_ENABLED=false
AGENT_CANARY_PCT=0
AGENT_TURN_DEADLINE_S=5.0
CURRENT_TURN_CONTEXT_ENABLED=false
